service vendor.camera-provider /vendor/bin/hw/vendor.qti.camera.provider-service_64
    interface aidl android.hardware.camera.provider.ICameraProvider/vendor_qti/0
    interface aidl vendor.qti.hardware.camera.postproc.IPostProcService/camerapostprocservice
    interface vendor.qti.hardware.camera.aon@1.0::IAONService aoncameraservice
    class hal
    user cameraserver
    group audio camera input drmrpc oem_2907
    ioprio rt 4
    capabilities SYS_NICE
    task_profiles CameraServiceCapacity CameraServicePerformance

on boot
    chown cameraserver camera /sys/module/camera/parameters/cam_error_inject

on property:sys.boot_completed=1
    write /dev/cpuctl/camera-daemon/cpu.shares 16384

# on property:vendor.camera.vm.status=open
#     write /proc/sys/vm/watermark_scale_factor 150
#     write /proc/sys/vm/swappiness 10

# on property:vendor.camera.vm.status=close
#     write /proc/sys/vm/watermark_scale_factor 60
#     write /proc/sys/vm/swappiness 150

on property:vendor.camera.vm.dropcache=1
    write /proc/sys/vm/drop_caches 1
    setprop vendor.camera.vm.dropcache 0

on property:vendor.camera.vm.status=*
    exec u:r:vendor_qti_init_shell:s0 -- /vendor/bin/init.qti.cam.perfopt.sh

